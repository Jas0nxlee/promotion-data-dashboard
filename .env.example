# TikHub API 令牌
# 获取: https://user.tikhub.io -> 用户中心 -> API令牌 -> 创建
TIKHUB_API_KEY=在此粘贴你的令牌

# SMTP 邮件发送（587 + STARTTLS 示例）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=发件账号
SMTP_PASSWORD=应用专用密码
SMTP_FROM=发件邮箱@example.com
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=30

# 可选：对外端口及采集参数
DASHBOARD_PORT=8080
VIDEO_FETCH_ARGS=
ARTICLE_FETCH_ARGS=
COMMENT_MONITOR_ARGS=--limit 0 --max-pages 200
COMMENT_EMAIL_MAX_EVENTS=100
TIKHUB_BASE_URL=https://api.tikhub.io

# 评论提醒收件人；环境变量会覆盖 config/platform_recipients.json
COMMENT_RECIPIENT_BILIBILI=receiver@example.com
COMMENT_OWNER_BILIBILI=负责人姓名
COMMENT_RECIPIENT_WECHAT_CHANNELS=receiver@example.com
COMMENT_OWNER_WECHAT_CHANNELS=负责人姓名
COMMENT_RECIPIENT_DOUYIN=receiver@example.com
COMMENT_OWNER_DOUYIN=负责人姓名
COMMENT_RECIPIENT_CSDN=receiver@example.com
COMMENT_RECIPIENT_ELECFANS=receiver@example.com
COMMENT_RECIPIENT_BAIJIAHAO=receiver@example.com
COMMENT_RECIPIENT_ZHIHU=receiver@example.com
COMMENT_RECIPIENT_WECHAT_SERVICE=receiver@example.com
COMMENT_RECIPIENT_WECHAT_SUBSCRIPTION=receiver@example.com
COMMENT_RECIPIENT_TOUTIAO=receiver@example.com
COMMENT_RECIPIENT_XIAOHONGSHU=receiver@example.com
# COMMENT_RECIPIENT_SOHU=receiver@example.com

# 可选批量覆盖；也支持 {"bilibili":"a@example.com"} 简写
# COMMENT_RECIPIENTS_JSON={"bilibili":{"email":"a@example.com","owner":"负责人"}}
