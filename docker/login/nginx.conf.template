# All processes remain inside the unprivileged-by-default container boundary.
# Keeping the worker root lets the bcrypt file stay mode 0600 in a 0700 directory.
user root;
worker_processes 1;
pid /tmp/promotion-login-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_max_body_size 256k;
    client_body_temp_path /tmp/promotion-login-body;
    proxy_temp_path /tmp/promotion-login-proxy;
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    map $http_origin $desktop_origin_allowed {
        default 0;
        "@@PANEL_ORIGIN@@" 1;
    }
    server {
        listen 18762;
        server_name _;
        if ($http_host != "@@PANEL_HOST@@") { return 421; }
        auth_basic "Promotion authorization";
        auth_basic_user_file "@@AUTH_FILE@@";
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;

        location = /desktop/ {
            root /app/docker/login;
            try_files /desktop.html =404;
            default_type text/html;
        }
        location = /desktop/websockify {
            if ($desktop_origin_allowed = 0) { return 403; }
            proxy_pass http://127.0.0.1:6080/;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Origin $http_origin;
            proxy_set_header Authorization "";
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }
        location /desktop/ {
            alias /usr/share/novnc/;
            autoindex off;
        }
        location / {
            proxy_pass http://127.0.0.1:18761;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header Origin $http_origin;
            proxy_set_header Authorization "";
            proxy_set_header X-Promotion-User $remote_user;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            proxy_read_timeout 180s;
        }
    }
}
